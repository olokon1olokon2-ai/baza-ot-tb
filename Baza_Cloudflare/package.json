{
  "name": "baza-ot-tb-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrations:apply && wrangler deploy",
    "db:create": "wrangler d1 create baza-ot-tb",
    "db:init": "wrangler d1 execute baza-ot-tb --file=./schema.sql",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote"
  }
}
